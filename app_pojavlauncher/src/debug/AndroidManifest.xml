<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allows plain HTTP to the development machine (local content tests). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/projects_debug_network">
        <!-- Debug builds only: the game's exit screen can be opened from adb, so a start that Sodium
             broke can be played on an emulator without breaking the game. -->
        <activity android:name="net.kdt.pojavlaunch.ExitActivity" android:exported="true" />
        <!-- Debug builds only (M19): a friends push sent from adb (DebugPushReceiver); only the shell
             (which holds DUMP) may send it, not another app. -->
        <receiver
            android:name="gg.projects.mobile.social.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
