<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Projects fork (M14): the top bar (landscape: 48dp tall). The account chip on the left, the settings/home button on
         the right (48dp targets, 24dp glyphs), and a hairline under it that carries the Microsoft
         sign-in progress (upstream: a thick orange line all the time). -->
    <FrameLayout
        android:id="@+id/projects_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/projects_top_bar_land"
        android:background="@color/background_status_bar"
        app:layout_constraintTop_toTopOf="parent">

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="64dp" />

        <gg.projects.mobile.ui.TopBarButton
            android:id="@+id/setting_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp" />

        <gg.projects.mobile.ui.TopBarLine
            android:id="@+id/projects_top_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <!-- Holding most of the dynamic content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@+id/projects_top_bar" />


    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
