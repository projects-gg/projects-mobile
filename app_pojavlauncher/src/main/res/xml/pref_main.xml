<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:key=""
    >

    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>

    <PreferenceCategory
        android:title="@string/preference_category_main_categories"
        >

        <Preference
            android:key="video_screen_setting"
            android:title="@string/preference_video_title"
            android:summary="@string/preference_video_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceVideoFragment"
            android:icon="@drawable/ic_setting_video"
            />


        <Preference
            android:key="control_screen_setting"
            android:title="@string/preference_control_title"
            android:summary="@string/preference_control_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceControlFragment"
            android:icon="@drawable/ic_menu_custom_controls"
            />

        <Preference
            android:key="java_screen_setting"
            android:title="@string/preference_java_title"
            android:summary="@string/preference_java_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceJavaFragment"
            android:icon="@drawable/ic_setting_java_runtime"
            />

        <Preference
            android:key="misc_screen_setting"
            android:title="@string/preference_misc_title"
            android:summary="@string/preference_misc_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceMiscellaneousFragment"
            android:icon="@drawable/ic_setting_misc"
            />


        <Preference
            android:key="experimental_screen_setting"
            android:title="@string/preference_experimental_title"
            android:summary="@string/preference_experimental_description"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceExperimentalFragment"
            android:icon="@drawable/projects_pref_flask"
            />
    </PreferenceCategory>

    <!-- Projects fork: the app's language (gg.projects.mobile.language). "Otomatik" is Turkish in
         Turkey or on a Turkish phone, else English; it replaces upstream's "force English" switch.
         The entries are set in LauncherPreferenceFragment ("Otomatik (Türkçe)"). -->
    <androidx.preference.ListPreference
        android:key="projects_language"
        android:title="@string/projects_language_title"
        android:defaultValue="auto"
        android:entries="@array/projects_language_values"
        android:entryValues="@array/projects_language_values"
        android:icon="@drawable/projects_pref_translate"
        />

    <!-- Projects fork (M14): touch feedback the player feels on presses, switches and sliders
         (gg.projects.mobile.ui.Haptics); Android's own touch feedback setting applies as well. -->
    <androidx.preference.SwitchPreferenceCompat
        android:key="projects_haptics"
        android:title="@string/projects_haptics_title"
        android:defaultValue="true"
        android:icon="@drawable/projects_pref_vibrate"
        />

    <Preference
        android:title="@string/preference_ask_for_notification_title"
        android:summary="@string/preference_ask_for_notification_description"
        android:key="notification_permission_request"
        android:icon="@drawable/projects_pref_bell"
        />
    <Preference
        android:title="@string/preference_ask_for_microphone_title"
        android:summary="@string/preference_ask_for_microphone_description"
        android:key="microphone_permission_request"
        android:icon="@drawable/projects_pref_microphone"
        />
    <!-- Projects fork: credits (LGPLv3 upstream notice) -->
    <Preference
        android:key="projects_about"
        android:selectable="false"
        android:title="@string/projects_about_title"
        android:summary="@string/projects_based_on"
        android:icon="@drawable/projects_pref_info"
        />
    <!-- Projects fork (M17): small and quiet under About (Mojang's usage guidelines; the owner's choice
         of place, 18 October 2026). -->
    <Preference
        android:key="projects_not_affiliated"
        android:layout="@layout/projects_preference_footnote"
        android:selectable="false"
        android:title="@string/projects_not_affiliated"
        />





</PreferenceScreen>