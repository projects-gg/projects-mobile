<?xml version="1.0" encoding="utf-8"?>
<!-- SOC-ID: "Microsoft ile giriş yap": the dark surface Microsoft's sign-in buttons use on dark pages, with a
     hairline, a step lighter while pressed; the same shape and height as Discord's Blurple button beside it
     (Blurple stays Discord's alone, design.md §6). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke
                android:width="1dp"
                android:color="@color/projects_obsidian_700" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/projects_obsidian_700" />
            <stroke
                android:width="1dp"
                android:color="@color/projects_obsidian_600" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke
                android:width="2dp"
                android:color="@color/projects_gold_300" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke
                android:width="1dp"
                android:color="@color/projects_obsidian_600" />
        </shape>
    </item>
</selector>
