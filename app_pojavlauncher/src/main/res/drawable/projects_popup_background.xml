<?xml version="1.0" encoding="utf-8"?>
<!-- Drop-down panels (account list, profile list, menus; M14): obsidian-800 with a hairline ring and
     the popup radius. The 6dp padding keeps the first and last rows' ripples off the corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/projects_radius_popup" />
    <solid android:color="@color/projects_obsidian_800" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
    <padding android:bottom="6dp" android:left="0dp" android:right="0dp" android:top="6dp" />
</shape>
