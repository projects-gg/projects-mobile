<?xml version="1.0" encoding="utf-8"?>
<!-- M053: a choice in the controls editor's lists: the row ripple, and the chosen one on the quiet plate (design.md §2:
     a chosen option is never gold). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/projects_ripple">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="#1FFFFFFF" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <color android:color="#FFFFFFFF" />
    </item>
</ripple>
