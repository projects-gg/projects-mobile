<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track (M14, the desktop's Switch): obsidian with a hairline ring when off, gold with a
     lighter gold ring when on; dimmed while disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="#80E89A2C" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="@color/projects_gold_500" />
            <stroke android:width="1dp" android:color="#99F0B849" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="#8027222C" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="@color/projects_obsidian_700" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
