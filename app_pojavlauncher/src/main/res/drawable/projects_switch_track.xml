<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track (M14, the desktop's Switch): obsidian with a hairline ring when off, bone with a
     white ring when on (0.4.6: the launcher's bone switch, one gold per screen); dimmed while disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="#80F3EBDD" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="@color/projects_bone_100" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="#8027222C" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="@color/projects_obsidian_700" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
