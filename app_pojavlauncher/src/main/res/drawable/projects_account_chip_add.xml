<?xml version="1.0" encoding="utf-8"?>
<!-- The account chip with no account yet (M14; the desktop's "Hesap ekle" pill): gold-tinted with a
     gold ring, the one invitation in the bar. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp">
    <ripple android:color="@color/projects_ripple_strong">
        <item>
            <selector android:enterFadeDuration="100" android:exitFadeDuration="200">
                <item android:state_pressed="true">
                    <shape android:shape="rectangle">
                        <corners android:radius="20dp" />
                        <solid android:color="#3DE89A2C" />
                        <stroke android:width="1dp" android:color="#99F0B849" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="20dp" />
                        <solid android:color="#26E89A2C" />
                        <stroke android:width="1dp" android:color="#66F0B849" />
                    </shape>
                </item>
            </selector>
        </item>
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <corners android:radius="20dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </item>
    </ripple>
</inset>
