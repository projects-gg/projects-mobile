<?xml version="1.0" encoding="utf-8"?>
<!-- FIX2: the top bar's friends pill once signed in (the desktop's title bar pill): dark glass with a
     faint ring, a touch lighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <corners android:radius="18dp" />
                <solid android:color="@color/projects_obsidian_700" />
                <stroke android:width="1dp" android:color="#29FFFFFF" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <corners android:radius="18dp" />
                <solid android:color="@color/projects_obsidian_800" />
                <stroke android:width="1dp" android:color="#14FFFFFF" />
            </shape>
        </inset>
    </item>
</selector>
