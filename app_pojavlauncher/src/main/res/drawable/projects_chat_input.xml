<?xml version="1.0" encoding="utf-8"?>
<!-- M20: the chat's writing field (the owner's wish: rounded, not a sharp rectangle): an obsidian-800
     pill with a quiet outline, gold while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke android:width="1dp" android:color="#B3E89A2C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke android:width="1dp" android:color="@color/projects_obsidian_700" />
        </shape>
    </item>
</selector>
