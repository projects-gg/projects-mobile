<?xml version="1.0" encoding="utf-8"?>
<!-- Raised row inside the Projects card (containers use the soft 10dp radius). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FF6D58E">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke android:width="1dp" android:color="@color/projects_obsidian_700" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
