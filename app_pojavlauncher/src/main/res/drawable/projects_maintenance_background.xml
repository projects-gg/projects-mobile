<?xml version="1.0" encoding="utf-8"?>
<!-- The notice on the Projects card (maintenance, or the status page's problem): maroon, with the
     gold ripple of the card's rows when it opens the status page. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FF6D58E">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/projects_ember_900" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
