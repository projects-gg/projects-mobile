<?xml version="1.0" encoding="utf-8"?>
<!-- "Discord'da aç": Discord's symbol on a Blurple tile (#5865F2), the one colour outside the palette (design.md).
     Insets instead of item sizes and gravity, which need API 23. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="20dp"
                android:height="20dp" />
            <corners android:radius="5dp" />
            <solid android:color="#5865F2" />
        </shape>
    </item>
    <item
        android:bottom="5.5dp"
        android:drawable="@drawable/projects_ic_discord_glyph"
        android:left="4dp"
        android:right="4dp"
        android:top="5.5dp" />
</layer-list>
