<?xml version="1.0" encoding="utf-8"?>
<!-- Text field like the desktop's Input: obsidian-800 with 6dp corners and a quiet outline, gold
     while focused, flare while the text has a problem (the field is then "activated"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke android:width="1dp" android:color="@color/projects_flare_400" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke android:width="1dp" android:color="@color/projects_gold_500" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/projects_obsidian_800" />
            <stroke android:width="1dp" android:color="@color/projects_obsidian_700" />
        </shape>
    </item>
</selector>
