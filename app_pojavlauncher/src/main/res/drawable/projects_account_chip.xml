<?xml version="1.0" encoding="utf-8"?>
<!-- The account chip in the top bar (M14; the desktop's account switcher pill): obsidian with a
     hairline ring, brighter while pressed, a gold ripple. 40dp drawn inside a 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp">
    <ripple android:color="@color/projects_ripple">
        <item>
            <selector android:enterFadeDuration="100" android:exitFadeDuration="200">
                <item android:state_pressed="true">
                    <shape android:shape="rectangle">
                        <corners android:radius="20dp" />
                        <solid android:color="@color/projects_obsidian_700" />
                        <stroke android:width="1dp" android:color="#29FFFFFF" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="20dp" />
                        <solid android:color="@color/projects_obsidian_800" />
                        <stroke android:width="1dp" android:color="#14FFFFFF" />
                    </shape>
                </item>
            </selector>
        </item>
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <corners android:radius="20dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </item>
    </ripple>
</inset>
