<?xml version="1.0" encoding="utf-8"?>
<!-- The default profile's tile (M14: instead of upstream's purple Amethyst cube): obsidian with the
     container radius. ICON2: ProfileIconCache puts the desktop's pixel grass block in it
     (PixelSpriteDrawable, whole pixels; it was a gold Phosphor cube). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="40dp" android:height="40dp" />
    <corners android:radius="10dp" />
    <solid android:color="@color/projects_obsidian_800" />
    <stroke android:width="1dp" android:color="@color/projects_obsidian_700" />
</shape>
