<?xml version="1.0" encoding="utf-8"?>
<!-- The status notice while services are down: the notice's maroon with a faint flare ring (the
     desktop's outage tone), and the same gold ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FF6D58E">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/projects_ember_900" />
            <stroke
                android:width="1dp"
                android:color="#4DF0624D" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
