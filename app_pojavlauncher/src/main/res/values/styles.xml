<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Projects fork: the brand theme lives in projects_styles.xml (Theme.Projects.Base); only the
         text size differs between portrait and landscape. -->
    <style name="AppTheme" parent="@style/Theme.Projects.Base">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="ProjectsAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/projects_gold_500</item>
        <item name="colorBackgroundFloating">@color/projects_obsidian_800</item>
        <item name="android:windowBackground">@drawable/projects_dialog_background</item>
        <item name="android:textColorPrimary">@color/projects_bone_100</item>
        <item name="android:textColorSecondary">@color/projects_ash_400</item>
        <item name="buttonBarPositiveButtonStyle">@style/ProjectsDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ProjectsDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/ProjectsDialogButton</item>
        <!-- M14: dialogs speak Figtree and press like every other button (gold ripple, haptics). -->
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
        <item name="colorControlHighlight">@color/projects_ripple</item>
        <item name="android:colorControlHighlight">@color/projects_ripple</item>
        <item name="colorControlActivated">@color/projects_gold_500</item>
        <item name="switchStyle">@style/ProjectsSwitchCompat</item>
        <item name="android:switchStyle">@style/ProjectsSwitch</item>
        <item name="viewInflaterClass">gg.projects.mobile.ui.ProjectsViewInflater</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Projects.ListItem</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Projects.ListItem</item>
        <item name="android:windowTitleStyle">@style/ProjectsDialogTitle</item>
    </style>

    <!-- M14: dialog titles in Tektur like every screen title (design.md: dialog title 17). -->
    <style name="ProjectsDialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/TextAppearance.Projects.DialogTitle</item>
    </style>

    <!-- Dialog buttons in sentence case (design.md: OYNA is the only all-caps label). -->
    <style name="ProjectsDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Projects fork: entry activity. Before Android 12 the window background is the splash;
         Android 12+ draws the system splash from the windowSplashScreen* attributes. -->
    <style name="AppTheme.Splash">
        <item name="android:windowBackground">@drawable/projects_splash</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/projects_obsidian_950</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/projects_obsidian_950</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <!-- Projects fork: sentence case (design.md: OYNA is the only all-caps label; Turkish capitals
             also turned "Discord" and "Wiki" into "DİSCORD" and "WİKİ"). -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/projects_menu_row</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
