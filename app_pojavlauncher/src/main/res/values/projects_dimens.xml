<?xml version="1.0" encoding="utf-8"?>
<!-- Projects layout tokens (M14; ProLauncher2 docs/design.md, scaled for touch). Spacing follows a
     4 dp grid, containers use the soft 10 dp radius, actions the chamfer ("hextech cut"). -->
<resources>
    <dimen name="projects_space_xs">4dp</dimen>
    <dimen name="projects_space_sm">8dp</dimen>
    <dimen name="projects_space_md">12dp</dimen>
    <dimen name="projects_space_lg">16dp</dimen>
    <dimen name="projects_space_xl">24dp</dimen>

    <dimen name="projects_radius_container">10dp</dimen>
    <dimen name="projects_radius_popup">12dp</dimen>
    <dimen name="projects_radius_sheet">16dp</dimen>

    <!-- Touch targets and icons: 48 dp targets, 24 dp icons (20 dp inline, 16 dp micro). -->
    <dimen name="projects_touch">48dp</dimen>
    <dimen name="projects_icon">24dp</dimen>
    <dimen name="projects_icon_inline">20dp</dimen>
    <dimen name="projects_icon_micro">16dp</dimen>

    <!-- Bars. -->
    <dimen name="projects_top_bar">56dp</dimen>
    <dimen name="projects_top_bar_land">48dp</dimen>
    <dimen name="projects_chip_height">40dp</dimen>
    <dimen name="projects_chip_head">24dp</dimen>
    <dimen name="projects_profile_row">60dp</dimen>
    <dimen name="projects_profile_icon">40dp</dimen>
    <dimen name="projects_play_height">56dp</dimen>
    <dimen name="projects_menu_row">56dp</dimen>

    <!-- Type scale (sp). -->
    <dimen name="projects_text_title">22sp</dimen>
    <dimen name="projects_text_section">17sp</dimen>
    <dimen name="projects_text_body">15sp</dimen>
    <dimen name="projects_text_control">15sp</dimen>
    <dimen name="projects_text_meta">13sp</dimen>
    <dimen name="projects_text_caption">12sp</dimen>
    <dimen name="projects_text_play">20sp</dimen>
    <!-- MOB-POLISH: the profile editor's field below the one above it (its label sits in the gap). -->
    <dimen name="projects_editor_field_gap">48dp</dimen>

    <!-- TABLET-M: wide windows (tablets, landscape, split screen). A screen keeps to one centred column (WideRoot,
         the mods screen's width since 0.1.x); sheets rise in the middle at most as wide as Material's; the home's
         two columns: the Projects card beside a side column, the pair centred. -->
    <dimen name="projects_column_max">720dp</dimen>
    <dimen name="projects_sheet_max">640dp</dimen>
    <dimen name="projects_side_column">360dp</dimen>
    <dimen name="projects_wide_group_max">1104dp</dimen>
    <!-- News covers at most this tall: the home card's, a news list row's, an article's (taller on a wide window,
         values-w600dp). -->
    <dimen name="projects_home_cover_max">200dp</dimen>
    <dimen name="projects_news_cover_max">180dp</dimen>
    <dimen name="projects_article_cover_max">220dp</dimen>
    <!-- Dialogs on a phone keep AppCompat's widths (0: none fixed); a wide window fixes them (values-w600dp). -->
    <dimen name="projects_dialog_fixed_width">0dp</dimen>
</resources>
