<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View tag: the running cross-fade of a home card block (CardMotion). -->
    <item name="projects_motion_ghost" type="id" />
    <!-- View tag: how many digits a countdown cell is sized for (ProjectsHomeCard). -->
    <!-- MOB-POLISH: whether a home card section has the ripple backing (it opens something). -->
    <item name="projects_section_pressable" type="id" />
    <!-- View tag: when the last slider tick played (Haptics.tick). -->
    <item name="projects_haptic_tick" type="id" />
    <!-- View tag: when a confirm or reject last played (Haptics), so the release tick keeps quiet. -->
    <item name="projects_haptic_strong" type="id" />
    <!-- View tag: the press style a view was given (Press), so it is attached once. -->
    <item name="projects_press_style" type="id" />
    <!-- View tag: a control drawer's button fading out (DrawerMotion), so it takes no new touch. -->
    <item name="projects_drawer_leaving" type="id" />
    <!-- View tag (M17): the home screen's undo bar, made once per menu view (UndoBar.attach). -->
    <item name="projects_undo_bar" type="id" />
    <!-- View tag (M17): whether a news category chip is styled for a Minecraft update (ProjectsUi.bindCategory). -->
    <item name="projects_chip_minecraft" type="id" />
    <!-- View tag (M20): which message a chat row showed and in what state, so a change cross-fades. -->
    <item name="projects_chat_state" type="id" />
    <!-- View tag (M20): which crew a rail mark shows (CrewFragment). -->
    <item name="projects_crew_rail_id" type="id" />
    <!-- View tag (FIX2): the accessibility action a row's menu was given (SocialMenuSheet.attach). -->
    <item name="projects_menu_action" type="id" />
    <!-- View tag (FIX2): the running height animation of a plan or call card's answers (AnswerList). -->
    <item name="projects_answers_anim" type="id" />
    <!-- View tag (MOB1): the link a chat composer's card shows (ChatFragment). -->
    <item name="projects_chat_composer_link" type="id" />
    <!-- View tag (MOB1): the line with one action on the screen's content root (ActionToast). -->
    <item name="projects_action_toast" type="id" />
    <!-- View tag (MOB1): which message a chat row's sticker belongs to, so a rebind of the same one keeps its motion. -->
    <item name="projects_chat_sticker_row" type="id" />
    <!-- TABLET-M: whether a conversation row wears the chosen look (two panes). -->
    <item name="projects_row_chosen" type="id" />
</resources>
