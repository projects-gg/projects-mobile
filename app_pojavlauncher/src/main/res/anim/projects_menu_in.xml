<?xml version="1.0" encoding="utf-8"?>
<!-- FIX2: a long-press menu arrives: it fades in while it grows from 94 % (window animations follow
     the system's animation scale; with animations off it simply appears). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha
        android:duration="180"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="220"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
