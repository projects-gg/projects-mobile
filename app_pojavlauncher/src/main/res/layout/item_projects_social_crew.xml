<?xml version="1.0" encoding="utf-8"?>
<!-- M19: the crew on the friends screen: its mark, name and tag, and who is online or calling. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/projects_social_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <gg.projects.mobile.social.ui.CrewMarkView
            android:id="@+id/projects_crew_row_mark"
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <ImageView
            android:id="@+id/projects_crew_row_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/projects_social_icon_tile"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/projects_ic_crew"
            android:tint="@color/projects_gold_300"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_crew_row_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_semibold"
                android:maxLines="1"
                android:textColor="@color/projects_bone_100"
                android:textSize="15sp"
                tools:text="Gece Kurtları" />

            <TextView
                android:id="@+id/projects_crew_row_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/tektur_semibold"
                android:letterSpacing="0.06"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textColor="@color/projects_bone_50"
                android:textSize="11sp"
                tools:text="GKR" />
        </LinearLayout>

        <TextView
            android:id="@+id/projects_crew_row_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="1"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="4 çevrimiçi" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/projects_ic_caret_right"
        android:tint="@color/projects_ash_400" />
</LinearLayout>
