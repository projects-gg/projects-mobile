<?xml version="1.0" encoding="utf-8"?>
<!-- M19: the crew's code (EKP-XXXX-XXXX), to copy or share; anyone with it can join. M21: the same row
     shows the crew's invite link (its label, the link, copy, share and, for whoever manages it, "more"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/projects_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_crew_code_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:text="@string/projects_crew_code"
            android:textColor="@color/projects_ash_300"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/projects_crew_code_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/tektur_semibold"
            android:letterSpacing="0.06"
            android:textColor="@color/projects_bone_100"
            android:textIsSelectable="true"
            android:textSize="18sp"
            tools:text="EKP-ABCD-EFGH" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/projects_crew_code_copy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/projects_icon_button_ripple"
        android:contentDescription="@string/projects_crew_copy"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/projects_ic_copy"
        android:tint="@color/projects_bone_100" />

    <ImageButton
        android:id="@+id/projects_crew_code_share"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/projects_icon_button_ripple"
        android:contentDescription="@string/projects_social_share"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/projects_ic_share"
        android:tint="@color/projects_bone_100" />

    <ImageButton
        android:id="@+id/projects_crew_code_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/projects_icon_button_ripple"
        android:contentDescription="@string/projects_link_more"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/projects_ic_dots"
        android:tint="@color/projects_bone_100"
        android:visibility="gone" />
</LinearLayout>
