<?xml version="1.0" encoding="utf-8"?>
<!-- A sub-screen's header (M14, ScreenHeader): back and the screen's title, the mod screen's
     header everywhere; an optional caption under the title. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/projects_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/projects_header_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/projects_icon_button_ripple"
            android:contentDescription="@string/projects_mods_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/projects_ic_caret_left"
            android:tint="@color/projects_bone_100" />

        <TextView
            android:id="@+id/projects_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Projects.Title"
            android:fontFamily="@font/tektur_semibold"
            android:textSize="@dimen/projects_text_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/projects_header_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/projects_ash_400"
        android:textSize="13sp"
        android:visibility="gone" />
</merge>
