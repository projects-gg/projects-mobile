<?xml version="1.0" encoding="utf-8"?>
<!-- M19: the player on the friends screen: their picture and status; a tap changes the status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/projects_social_row_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <gg.projects.mobile.social.ui.AvatarView
        android:id="@+id/projects_me_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_me_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="1"
            android:textColor="@color/projects_bone_100"
            android:textSize="16sp"
            tools:text="Deniz" />

        <TextView
            android:id="@+id/projects_me_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="Çevrimiçi" />

        <!-- M20 (SPAM1): "Sınırlı hesap" on the player's own row only; a tap says what and until when. -->
        <TextView
            android:id="@+id/projects_me_limited"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/projects_limited_chip"
            android:clickable="true"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="11dp"
            android:text="@string/projects_limited_chip"
            android:textColor="@color/projects_ash_300"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/projects_ic_caret_down_bold"
        android:tint="@color/projects_ash_400" />
</LinearLayout>
