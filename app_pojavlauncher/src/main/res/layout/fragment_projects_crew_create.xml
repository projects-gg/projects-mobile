<?xml version="1.0" encoding="utf-8"?>
<!-- M19: "Ekip kur": a live preview of the crew's mark and name, then name, tag, motto, emblem, colour
     and frame (colour, frame and motto where the service offers looks). MOB-POLISH: the page fades out under
     the header (FadingScrollView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/projects_crew_create" />

    <gg.projects.mobile.social.ui.FadingScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/projects_card_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <gg.projects.mobile.social.ui.CrewMarkView
                    android:id="@+id/projects_create_mark"
                    android:layout_width="64dp"
                    android:layout_height="64dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/projects_create_preview_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/tektur_semibold"
                            android:maxLines="2"
                            android:textColor="@color/projects_bone_100"
                            android:textSize="19sp"
                            tools:text="Gece Kurtları" />

                        <TextView
                            android:id="@+id/projects_create_preview_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/tektur_semibold"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/projects_bone_50"
                            android:textSize="12sp"
                            tools:text="GKR" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/projects_create_preview_motto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/figtree_regular"
                        android:textColor="@color/projects_ash_300"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ProjectsFormLabel"
                android:labelFor="@+id/projects_create_name"
                android:text="@string/projects_crew_name" />

            <EditText
                android:id="@+id/projects_create_name"
                style="@style/ProjectsFormInput"
                android:inputType="textCapWords|textNoSuggestions"
                android:maxLength="40" />

            <TextView
                android:id="@+id/projects_create_name_error"
                style="@style/ProjectsFormError" />

            <TextView
                style="@style/ProjectsFormLabel"
                android:labelFor="@+id/projects_create_tag"
                android:text="@string/projects_crew_tag" />

            <EditText
                android:id="@+id/projects_create_tag"
                style="@style/ProjectsFormInput"
                android:layout_width="120dp"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:maxLength="8" />

            <TextView
                android:id="@+id/projects_create_tag_error"
                style="@style/ProjectsFormError" />

            <LinearLayout
                android:id="@+id/projects_create_motto_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProjectsFormLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:labelFor="@+id/projects_create_motto"
                        android:text="@string/projects_crew_motto" />

                    <TextView
                        android:id="@+id/projects_create_motto_count"
                        style="@style/ProjectsFormLabel"
                        android:textColor="@color/projects_ash_400"
                        tools:text="0/40" />
                </LinearLayout>

                <EditText
                    android:id="@+id/projects_create_motto"
                    style="@style/ProjectsFormInput"
                    android:hint="@string/projects_crew_motto_optional"
                    android:inputType="textCapSentences|textNoSuggestions"
                    android:maxLength="60" />

                <TextView
                    android:id="@+id/projects_create_motto_error"
                    style="@style/ProjectsFormError" />
            </LinearLayout>

            <TextView
                style="@style/ProjectsFormLabel"
                android:text="@string/projects_crew_emblem" />

            <GridLayout
                android:id="@+id/projects_create_emblems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="6" />

            <LinearLayout
                android:id="@+id/projects_create_look"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ProjectsFormLabel"
                    android:text="@string/projects_crew_color" />

                <GridLayout
                    android:id="@+id/projects_create_colors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="6" />

                <TextView
                    style="@style/ProjectsFormLabel"
                    android:text="@string/projects_crew_frame" />

                <LinearLayout
                    android:id="@+id/projects_create_frames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <com.kdt.mcgui.MineButton
                android:id="@+id/projects_create_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/projects_crew_create_submit"
                android:textSize="16sp" />
        </LinearLayout>
    </gg.projects.mobile.social.ui.FadingScrollView>
</LinearLayout>
