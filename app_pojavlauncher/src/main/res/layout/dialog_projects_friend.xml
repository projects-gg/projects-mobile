<?xml version="1.0" encoding="utf-8"?>
<!-- M19: a friend's card: who and where, "Katıl" when they are on Projects, then the quieter actions
     (Discord, favourite, crew invite) and, apart, the two that end something (remove, block). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <gg.projects.mobile.social.ui.AvatarView
                android:id="@+id/projects_card_avatar"
                android:layout_width="66dp"
                android:layout_height="66dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/projects_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/tektur_semibold"
                    android:maxLines="2"
                    android:textColor="@color/projects_bone_100"
                    android:textSize="19sp"
                    tools:text="Ayşe" />

                <TextView
                    android:id="@+id/projects_card_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_regular"
                    android:maxLines="1"
                    android:textColor="@color/projects_ash_400"
                    android:textSize="13sp"
                    tools:text="\@ayse" />

                <TextView
                    android:id="@+id/projects_card_presence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/figtree_semibold"
                    android:textColor="@color/projects_ash_300"
                    android:textSize="14sp"
                    tools:text="Projects'te" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/projects_card_since"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="12 Eylül 2026 tarihinden beri arkadaşsınız" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/projects_card_join"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/projects_social_join"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/projects_card_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
