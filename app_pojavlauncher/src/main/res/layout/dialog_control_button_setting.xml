<?xml version="1.0" encoding="utf-8"?>
<!-- Projects fork (M053): the key's panel in the app's look (mob-next "Bulgular"): Figtree, ash labels over bone values,
     filled obsidian fields without underlines, a field-looking direction picker with its caret, swatches on the colour
     rows, sizes in the same units on every screen. Ids and widget types are upstream's (EditControlSideDialog binds them);
     groups only hold rows together, and EditControlSideDialog shows every row again before a key's values hide some. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edit_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Name -->
    <TextView
        android:id="@+id/editName_textView"
        style="@style/ProjectsCtrlLabel"
        android:text="@string/global_name" />

    <EditText
        android:id="@+id/editName_editText"
        style="@style/ProjectsCtrlField"
        android:layout_width="match_parent"
        android:hint="@string/projects_control_button_name"
        android:imeOptions="flagNoExtractUi|actionDone"
        android:maxLines="1" />

    <!-- Size: width and height, each named -->
    <TextView
        android:id="@+id/editSize_textView"
        style="@style/ProjectsCtrlLabel"
        android:text="@string/customctrl_size" />

    <LinearLayout
        android:id="@+id/projects_ctrl_size_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editSize_editTextX"
            style="@style/ProjectsCtrlField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/projects_ctrl_width"
            android:gravity="center"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/editSize_x_textView"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="×"
            android:textColor="@color/projects_ash_400"
            android:textSize="15sp"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/editSize_editTextY"
            style="@style/ProjectsCtrlField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/projects_ctrl_height"
            android:gravity="center"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:inputType="number"
            android:maxLength="4" />
    </LinearLayout>

    <!-- Keys: four pick fields; the hidden spinners under them open the lists (upstream's way round the drop-down
         offset). -->
    <TextView
        android:id="@+id/editMapping_textView"
        style="@style/ProjectsCtrlLabel"
        android:text="@string/customctrl_mapping" />

    <LinearLayout
        android:id="@+id/projects_ctrl_mapping_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Spinner
                android:id="@+id/editMapping_spinner_1"
                style="@style/ProjectsCtrlHiddenSpinner" />

            <Spinner
                android:id="@+id/editMapping_spinner_2"
                style="@style/ProjectsCtrlHiddenSpinner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mapping_1_textview"
                    style="@style/ProjectsCtrlPick"
                    tools:text="SHIFT_LEFT" />

                <TextView
                    android:id="@+id/editMapping_plus_1"
                    style="@style/ProjectsCtrlPlus" />

                <TextView
                    android:id="@+id/mapping_2_textview"
                    style="@style/ProjectsCtrlPick"
                    tools:text="Boş" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/editMapping_spinner_3"
                style="@style/ProjectsCtrlHiddenSpinner" />

            <Spinner
                android:id="@+id/editMapping_spinner_4"
                style="@style/ProjectsCtrlHiddenSpinner" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mapping_3_textview"
                    style="@style/ProjectsCtrlPick"
                    tools:text="Boş" />

                <TextView
                    android:id="@+id/editMapping_plus_3"
                    style="@style/ProjectsCtrlPlus" />

                <TextView
                    android:id="@+id/mapping_4_textview"
                    style="@style/ProjectsCtrlPick"
                    tools:text="Boş" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- A drawer's direction -->
    <TextView
        android:id="@+id/editOrientation_textView"
        style="@style/ProjectsCtrlLabel"
        android:text="@string/customctrl_orientation" />

    <Spinner
        android:id="@+id/editOrientation_spinner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/projects_ctrl_select"
        android:popupBackground="@drawable/projects_popup_background"
        android:spinnerMode="dropdown" />

    <!-- Switches -->
    <Switch
        android:id="@+id/checkboxToggle"
        style="@style/ProjectsCtrlSwitch"
        android:layout_marginTop="12dp"
        android:text="@string/customctrl_toggle"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/checkboxPassThrough"
        style="@style/ProjectsCtrlSwitch"
        android:text="@string/customctrl_passthru"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/checkboxSwipeable"
        style="@style/ProjectsCtrlSwitch"
        android:text="@string/customctrl_swipeable"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/checkboxForwardLock"
        style="@style/ProjectsCtrlSwitch"
        android:text="@string/customctrl_forward_lock"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/checkboxAbsoluteFingerTracking"
        style="@style/ProjectsCtrlSwitch"
        android:text="@string/customctrl_absolute_tracking"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <!-- Look: the two colours (a swatch of each at the end), then the sliders -->
    <TextView
        android:id="@+id/editBackgroundColor_textView"
        style="@style/ProjectsCtrlRow"
        android:layout_marginTop="8dp"
        android:text="@string/customctrl_background_color" />

    <TextView
        android:id="@+id/editStrokeColor_textView"
        style="@style/ProjectsCtrlRow"
        android:text="@string/customctrl_stroke_color" />

    <LinearLayout
        style="@style/ProjectsCtrlSliderHead"
        android:id="@+id/projects_ctrl_stroke_head">

        <TextView
            android:id="@+id/editStrokeWidth_textView"
            style="@style/ProjectsCtrlSliderName"
            android:text="@string/customctrl_stroke_width" />

        <TextView
            android:id="@+id/editStrokeWidth_textView_percent"
            style="@style/ProjectsCtrlSliderValue" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/editStrokeWidth_seekbar"
        style="@style/ProjectsCtrlSlider" />

    <LinearLayout
        style="@style/ProjectsCtrlSliderHead"
        android:id="@+id/projects_ctrl_corner_head">

        <TextView
            android:id="@+id/editCornerRadius_textView"
            style="@style/ProjectsCtrlSliderName"
            android:text="@string/customctrl_corner_radius" />

        <TextView
            android:id="@+id/editCornerRadius_textView_percent"
            style="@style/ProjectsCtrlSliderValue" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/editCornerRadius_seekbar"
        style="@style/ProjectsCtrlSlider" />

    <LinearLayout
        style="@style/ProjectsCtrlSliderHead"
        android:id="@+id/projects_ctrl_opacity_head">

        <TextView
            android:id="@+id/editButtonOpacity_textView"
            style="@style/ProjectsCtrlSliderName"
            android:text="@string/customctrl_button_opacity" />

        <TextView
            android:id="@+id/editButtonOpacity_textView_percent"
            style="@style/ProjectsCtrlSliderValue" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/editButtonOpacity_seekbar"
        style="@style/ProjectsCtrlSlider" />

    <!-- Where the key shows -->
    <TextView
        android:id="@+id/visibility_textview"
        style="@style/ProjectsCtrlLabel"
        android:text="@string/customctrl_visibility_title" />

    <CheckBox
        android:id="@+id/visibility_game_checkbox"
        style="@style/ProjectsCtrlCheck"
        android:text="@string/customctrl_visibility_ingame" />

    <CheckBox
        android:id="@+id/visibility_menu_checkbox"
        style="@style/ProjectsCtrlCheck"
        android:text="@string/customctrl_visibility_in_menus" />

</LinearLayout>
