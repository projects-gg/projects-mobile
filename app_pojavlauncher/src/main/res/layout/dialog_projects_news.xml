<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/projects_article_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxHeight="220dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_article_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/projects_chip_background"
                android:fontFamily="@font/figtree_semibold"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/projects_gold_300"
                android:textSize="12sp"
                tools:text="Yama notları" />

            <TextView
                android:id="@+id/projects_article_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_400"
                android:textSize="12sp"
                tools:text="15 Ekim 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/projects_article_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/tektur_semibold"
            android:textColor="@color/projects_bone_100"
            android:textSize="22sp"
            tools:text="2.3 yama notları" />

        <TextView
            android:id="@+id/projects_article_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Projects Ekibi"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/projects_article_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/figtree_regular"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/projects_bone_100"
            android:textColorLink="@color/projects_gold_300"
            android:textIsSelectable="false"
            android:textSize="16sp"
            tools:text="Yenilikler" />
    </LinearLayout>
</ScrollView>
