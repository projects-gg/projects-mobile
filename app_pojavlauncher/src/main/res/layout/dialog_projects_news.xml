<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <!-- Fixed 16:9 box: the dialog keeps its size when the picture arrives. -->
        <gg.projects.mobile.ui.CoverView
            android:id="@+id/projects_article_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/projects_article_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tektur_semibold"
            android:textColor="@color/projects_bone_100"
            android:textSize="22sp"
            tools:text="2.3 yama notları" />

        <!-- What it is and when, in one quiet line under the title (MOB-POLISH: no coloured pill). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_article_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12.5sp"
                tools:text="Yama notları" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/figtree_regular"
                android:importantForAccessibility="no"
                android:text="@string/projects_meta_separator"
                android:textColor="@color/projects_ash_400"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/projects_article_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12.5sp"
                tools:text="15 Ekim 2026" />

            <!-- Discord posts: the original message, with Discord's own symbol and colour. -->
            <LinearLayout
                android:id="@+id/projects_article_discord"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/projects_discord_tile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/figtree_semibold"
                    android:maxLines="1"
                    android:text="@string/projects_open_in_discord"
                    android:textColor="@color/projects_bone_100"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/projects_article_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Projects Ekibi"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/projects_article_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/figtree_regular"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/projects_bone_100"
            android:textColorLink="@color/projects_gold_300"
            android:textIsSelectable="false"
            android:textSize="16sp"
            tools:text="Yenilikler" />
    </LinearLayout>
</ScrollView>
