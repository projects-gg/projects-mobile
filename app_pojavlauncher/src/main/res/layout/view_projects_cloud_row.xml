<?xml version="1.0" encoding="utf-8"?>
<!-- AFKPLUS-M: the main menu's "7/24 Bulut" row for a player with cloud accounts: the line that matters most
     (an approval waiting, an account that stopped, how many are in the game). It opens the cloud screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_cloud_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/projects_social_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/projects_cloud_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/projects_social_icon_tile"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/projects_ic_cloud"
        android:tint="@color/projects_gold_300" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_cloud_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="1"
            android:text="@string/projects_cloud_title"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/projects_cloud_row_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="1"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="3 hesaptan 2'si oyunda" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/projects_ic_caret_right"
        android:tint="@color/projects_ash_400" />
</LinearLayout>
