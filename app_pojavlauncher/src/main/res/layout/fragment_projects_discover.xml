<?xml version="1.0" encoding="utf-8"?>
<!-- MOB-PARITY "Ekip bul" (CREW-DISCOVER): the search and the tag chips above the listed crews' cards; one line in the
     middle while it loads nothing, is empty, finds nothing, failed or is off. Built in DiscoverFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/projects_discover_title" />

    <EditText
        android:id="@+id/projects_discover_search"
        style="@style/ProjectsFormInput"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/projects_discover_search"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="60" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/projects_discover_chips"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <gg.projects.mobile.social.ui.FadingRecyclerView
            android:id="@+id/projects_discover_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/projects_discover_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/projects_discover_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center"
                android:textColor="@color/projects_bone_100"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/projects_discover_state_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/projects_ash_300"
                android:textSize="14sp" />

            <Button
                android:id="@+id/projects_discover_retry"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/projects_retry"
                android:textAllCaps="false"
                android:textColor="@color/projects_gold_300"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/projects_discover_progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/projects_gold_400"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
