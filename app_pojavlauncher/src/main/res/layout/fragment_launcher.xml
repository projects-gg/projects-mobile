<?xml version="1.0" encoding="utf-8"?>
<!-- Projects fork (M14): the main menu. The Projects card, the tools in one rounded group of calm
     rows, and the play bar: the profile row (icon, name, version, caret) with its edit button, and
     OYNA, the one loud element. -->
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/fragment_menu_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/background_app">

	<ScrollView
		android:id="@+id/projects_menu_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:clipToPadding="false"
		android:paddingBottom="12dp"
		app:layout_constraintBottom_toTopOf="@id/_background_display_view"
		app:layout_constraintTop_toTopOf="parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Projects: news card and the join action -->
			<include
				android:id="@+id/projects_card"
				layout="@layout/view_projects_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_marginTop="12dp"
				android:layout_marginEnd="12dp"
				android:layout_marginBottom="6dp" />

			<LinearLayout
				android:id="@+id/projects_menu_group"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_marginTop="6dp"
				android:layout_marginEnd="12dp"
				android:background="@drawable/projects_menu_group"
				android:clipToOutline="true"
				android:orientation="vertical"
				tools:targetApi="31">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<com.kdt.mcgui.LauncherMenuButton
						android:id="@+id/news_button"
						style="@style/LauncherMenuButton.Universal"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:drawableStart="@drawable/ic_menu_news"
						android:text="@string/mcl_tab_wiki" />

					<View
						android:id="@+id/social_divider"
						android:layout_width="1dp"
						android:layout_height="24dp"
						android:background="@color/projects_obsidian_700" />

					<com.kdt.mcgui.LauncherMenuButton
						android:id="@+id/discord_button"
						style="@style/LauncherMenuButton.Universal"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:drawableStart="@drawable/ic_discord"
						android:text="@string/mcl_button_discord" />
				</LinearLayout>

				<View style="@style/ProjectsMenuDivider" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/custom_control_button"
					style="@style/LauncherMenuButton.Universal"
					android:layout_width="match_parent"
					android:drawableStart="@drawable/ic_menu_custom_controls"
					android:text="@string/mcl_option_customcontrol" />

				<View style="@style/ProjectsMenuDivider" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/install_jar_button"
					style="@style/LauncherMenuButton.Universal"
					android:layout_width="match_parent"
					android:drawableStart="@drawable/ic_menu_install_jar"
					android:text="@string/main_install_jar_file" />

				<View style="@style/ProjectsMenuDivider" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/share_logs_button"
					style="@style/LauncherMenuButton.Universal"
					android:layout_width="match_parent"
					android:drawableStart="@drawable/projects_menu_share"
					android:text="@string/main_share_logs" />

				<View style="@style/ProjectsMenuDivider" />

				<com.kdt.mcgui.LauncherMenuButton
					android:id="@+id/open_files_button"
					style="@style/LauncherMenuButton.Universal"
					android:layout_width="match_parent"
					android:drawableStart="@drawable/ic_folder"
					android:text="@string/mcl_button_open_directory" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<!-- The play bar's backing (cosmetic): from 8dp above the profile row to the bottom. -->
	<Space
		android:id="@+id/projects_play_bar_top"
		android:layout_width="match_parent"
		android:layout_height="8dp"
		app:layout_constraintBottom_toTopOf="@id/mc_version_spinner" />

	<View
		android:id="@+id/_background_display_view"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="@color/background_bottom_bar"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintTop_toTopOf="@id/projects_play_bar_top" />

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/projects_hairline"
		app:layout_constraintTop_toTopOf="@id/_background_display_view" />

	<com.kdt.mcgui.mcVersionSpinner
		android:id="@+id/mc_version_spinner"
		android:layout_width="0dp"
		android:layout_height="@dimen/projects_profile_row"
		android:layout_marginStart="8dp"
		android:layout_marginBottom="6dp"
		android:background="@drawable/projects_profile_row"
		android:drawableEnd="@drawable/projects_profile_caret"
		app:drawableEndSize="@dimen/projects_icon_inline"
		app:drawableStartSize="@dimen/projects_profile_icon"
		app:drawableStartIntegerScaling="true"
		app:layout_constraintBottom_toTopOf="@id/play_button"
		app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
		app:layout_constraintStart_toStartOf="parent" />

	<ImageButton
		android:id="@+id/edit_profile_button"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_marginStart="4dp"
		android:layout_marginEnd="8dp"
		android:background="@drawable/projects_icon_button_ripple"
		android:contentDescription="@string/projects_profile_edit"
		android:padding="12dp"
		android:scaleType="fitCenter"
		android:src="@drawable/projects_ic_pencil"
		android:tint="@color/projects_ash_300"
		app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

	<!-- 56dp of gold face inside a 3dp socket (PlayButtonDrawable). -->
	<com.kdt.mcgui.MineButton
		android:id="@+id/play_button"
		android:layout_width="match_parent"
		android:layout_height="62dp"
		android:layout_marginHorizontal="13dp"
		android:layout_marginBottom="13dp"
		android:text="@string/main_play"
		android:textAllCaps="true"
		app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
