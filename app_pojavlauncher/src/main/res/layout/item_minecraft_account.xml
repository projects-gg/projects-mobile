<?xml version="1.0" encoding="utf-8"?>
<!-- Projects fork (M14): a row of the account list under the top bar's chip: the crisp head, the
     name, and the remove button as a 48dp icon button. The first row is "Hesap ekle".
     SWIPE-M: a pinned account carries a small filled pin right after its name (the desktop's
     switcher); the name gives way to it when it is long. Holding a row opens its menu. The remove
     button is clickable but not explicitly focusable: a ListView ignores a tap on a row that holds an
     explicitly focusable view (AbsListView.onTouchUp), which would leave the row's own tap, the
     account pick, to nothing.
     AFK-M-UI: a name AFK on this phone reads "AFK'da" under it (the desktop's account mark); without it
     the name stays centred in the row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/projects_account_row_head"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="center" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/account_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:singleLine="true"
            android:textColor="@color/projects_bone_100"
            android:textSize="16sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/projects_account_row_afk"
            app:layout_constraintEnd_toStartOf="@+id/projects_account_row_pin"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Golge_Avci" />

        <TextView
            android:id="@+id/projects_account_row_afk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_regular"
            android:singleLine="true"
            android:text="@string/projects_afk_ui_mark"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/account_item"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/projects_account_row_pin"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_push_pin_fill"
            android:tint="@color/projects_ash_400"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/account_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/account_item"
            app:layout_constraintTop_toTopOf="@+id/account_item"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/delete_account_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/projects_icon_button_ripple"
        android:clickable="true"
        android:contentDescription="@string/global_delete"
        android:padding="14dp"
        android:src="@drawable/projects_ic_trash"
        android:tint="@color/projects_ash_400" />

</LinearLayout>
