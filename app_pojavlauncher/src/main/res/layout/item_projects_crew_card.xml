<?xml version="1.0" encoding="utf-8"?>
<!-- M19: the crew's card (the desktop's crew card): its mark, name, tag and motto, how many and since
     when, with the emblem large and faint behind its corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/projects_card_background">

    <ImageView
        android:id="@+id/projects_crew_card_watermark"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-24dp"
        android:layout_marginEnd="-28dp"
        android:alpha="0.07"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <gg.projects.mobile.social.ui.CrewMarkView
            android:id="@+id/projects_crew_card_mark"
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/projects_crew_card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/tektur_semibold"
                    android:maxLines="2"
                    android:textColor="@color/projects_bone_100"
                    android:textSize="19sp"
                    tools:text="Gece Kurtları" />

                <TextView
                    android:id="@+id/projects_crew_card_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/tektur_semibold"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/projects_bone_50"
                    android:textSize="12sp"
                    tools:text="GKR" />
            </LinearLayout>

            <TextView
                android:id="@+id/projects_crew_card_motto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_300"
                android:textSize="14sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="Gece bizimdir"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/projects_crew_card_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_400"
                android:textSize="13sp"
                tools:text="7/30 üye · Kuruluş 20 Eylül 2026" />

            <!-- TEAM6: "Etiketi tak" / "Etiket takılı" (quiet with its reason while hidden or locked); a 48 dp
                 target around a 36 dp chip. -->
            <TextView
                android:id="@+id/projects_crew_card_wear"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="-6dp"
                android:background="@drawable/projects_crew_wear_bg"
                android:drawablePadding="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Etiketi tak"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
