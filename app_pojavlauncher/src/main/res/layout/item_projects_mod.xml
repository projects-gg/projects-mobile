<?xml version="1.0" encoding="utf-8"?>
<!-- One recommended mod: icon, title with badges, summary, notes and the switch. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/projects_mod_highlight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/projects_mod_row_changed" />

    <LinearLayout
        android:id="@+id/projects_mod_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/projects_mod_row_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/projects_mod_icon_frame"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/projects_icon_placeholder">

            <TextView
                android:id="@+id/projects_mod_monogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/tektur_semibold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/projects_gold_300"
                android:textSize="18sp"
                tools:text="S" />

            <ImageView
                android:id="@+id/projects_mod_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title with its badges right after it; a long title shrinks and ellipsizes. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/projects_mod_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_semibold"
                    android:maxLines="1"
                    android:textColor="@color/projects_bone_100"
                    android:textSize="15sp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/projects_mod_badge_new"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Sodium" />

                <TextView
                    android:id="@+id/projects_mod_badge_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/projects_badge_gold"
                    android:fontFamily="@font/figtree_semibold"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="@string/projects_mods_badge_new"
                    android:textColor="@color/projects_gold_300"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/projects_mod_badge"
                    app:layout_constraintStart_toEndOf="@id/projects_mod_title"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/projects_mod_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/projects_chip_background"
                    android:fontFamily="@font/figtree_semibold"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/projects_ash_400"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/projects_mod_badge_new"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="8dp"
                    tools:text="Güncelleme var"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/projects_mod_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_regular"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="2"
                android:textColor="@color/projects_ash_400"
                android:textSize="13sp"
                tools:text="Daha yüksek FPS, daha akıcı oyun." />

            <TextView
                android:id="@+id/projects_mod_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/figtree_regular"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:text="Iris için gerekli."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/projects_mod_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center_vertical"
                android:text="@string/projects_mods_unsupported"
                android:textColor="@color/projects_flare_400"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/projects_mod_revert"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:text="@string/projects_mods_revert"
                android:textAllCaps="false"
                android:textColor="@color/projects_bone_100"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/projects_mod_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="9dp"
            android:thumb="@drawable/projects_switch_thumb"
            app:thumbTint="@color/projects_switch_thumb_tint"
            app:track="@drawable/projects_switch_track"
            app:trackTint="@color/projects_switch_track_tint" />
    </LinearLayout>
</FrameLayout>
