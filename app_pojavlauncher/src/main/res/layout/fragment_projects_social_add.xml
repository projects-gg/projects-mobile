<?xml version="1.0" encoding="utf-8"?>
<!-- M19: "Arkadaş ekle": the player's own code (copy, share, its QR) and a friend's code to find.
     MOB-POLISH: the page fades out under the header (FadingScrollView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/projects_social_add" />

    <gg.projects.mobile.social.ui.FadingScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/projects_card_background"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/projects_social_your_code"
                    android:textColor="@color/projects_ash_300"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/projects_add_my_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/tektur_semibold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/projects_gold_200"
                    android:textIsSelectable="true"
                    android:textSize="26sp"
                    tools:text="PRJ-ABCD-EFGH" />

                <ImageView
                    android:id="@+id/projects_add_qr"
                    android:layout_width="184dp"
                    android:layout_height="184dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/projects_social_qr_background"
                    android:contentDescription="@string/projects_social_qr"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/projects_add_copy"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/projects_ic_copy"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/figtree_semibold"
                        android:minHeight="44dp"
                        android:text="@string/projects_social_copy_code"
                        android:textAllCaps="false"
                        android:textColor="@color/projects_bone_100"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/projects_add_share"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:drawableStart="@drawable/projects_ic_share"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/figtree_semibold"
                        android:minHeight="44dp"
                        android:text="@string/projects_social_share"
                        android:textAllCaps="false"
                        android:textColor="@color/projects_bone_100"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/projects_add_rotate"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/projects_link_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/figtree_regular"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/projects_social_rotate"
                    android:textColor="@color/projects_ash_400"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/figtree_semibold"
                android:labelFor="@+id/projects_add_code"
                android:text="@string/projects_social_friend_code"
                android:textColor="@color/projects_bone_100"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/projects_add_code"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/projects_input"
                    android:fontFamily="@font/figtree_regular"
                    android:hint="PRJ-XXXX-XXXX"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/projects_bone_100"
                    android:textColorHint="@color/projects_obsidian_600"
                    android:textSize="16sp"
                    tools:ignore="HardcodedText" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/projects_add_find"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="88dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/projects_social_find"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/projects_add_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_flare_400"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Bu koda ait kimse bulunamadı."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/projects_add_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/projects_social_section_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <gg.projects.mobile.social.ui.AvatarView
                    android:id="@+id/projects_add_result_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/projects_add_result_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/figtree_semibold"
                        android:maxLines="1"
                        android:textColor="@color/projects_bone_100"
                        android:textSize="16sp"
                        tools:text="Ayşe" />

                    <TextView
                        android:id="@+id/projects_add_result_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_regular"
                        android:textColor="@color/projects_ash_400"
                        android:textSize="13sp"
                        tools:text="Zaten arkadaşsınız" />
                </LinearLayout>

                <Button
                    android:id="@+id/projects_add_send"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/figtree_semibold"
                    android:minHeight="44dp"
                    android:text="@string/projects_social_send"
                    android:textAllCaps="false"
                    android:textColor="@color/projects_bone_100"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </gg.projects.mobile.social.ui.FadingScrollView>
</LinearLayout>
