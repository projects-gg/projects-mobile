<?xml version="1.0" encoding="utf-8"?>
<!-- Projects fork (M14): "Hesap ekle" as a sub-screen (the desktop's add-account panel): the header,
     Microsoft as the main action, "ya da", and the offline account as the quiet second choice. The
     column keeps a phone's width on wide screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_add_account" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp">

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/projects_auth_microsoft"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="440dp" />

        <LinearLayout
            android:id="@+id/projects_auth_or"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/button_microsoft_authentication"
            app:layout_constraintStart_toStartOf="@id/button_microsoft_authentication"
            app:layout_constraintTop_toBottomOf="@id/button_microsoft_authentication">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/projects_obsidian_700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/projects_or"
                android:textColor="@color/projects_ash_400"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/projects_obsidian_700" />
        </LinearLayout>

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_local_authentication"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/projects_auth_local"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/button_microsoft_authentication"
            app:layout_constraintStart_toStartOf="@id/button_microsoft_authentication"
            app:layout_constraintTop_toBottomOf="@id/projects_auth_or" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
