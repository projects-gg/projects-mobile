<?xml version="1.0" encoding="utf-8"?>
<!-- AFKPLUS-M: a 7/24 Bulut screen. The header, an optional fixed row under it (the settings' tabs), the
     scrolling content built in code (CloudScreen), and an optional bar at the bottom (the save bar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:id="@+id/projects_cloud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp" />

    <FrameLayout
        android:id="@+id/projects_cloud_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/projects_cloud_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="20dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical">
        <!-- AFKPLUS-M2: content that scrolls under the fixed header fades out instead of being cut hard (half lines
             showed under the header's caption). -->

        <LinearLayout
            android:id="@+id/projects_cloud_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/projects_cloud_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
