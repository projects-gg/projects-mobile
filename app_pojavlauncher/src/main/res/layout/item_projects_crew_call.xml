<?xml version="1.0" encoding="utf-8"?>
<!-- M19: the crew's call ("Ekibi çağır"): who calls and whether they are on Projects, the three answers
     (the player's own one marked), who answered what; the caller sees the time left and "Bitir". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/projects_social_section_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/projects_call_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp">

            <gg.projects.mobile.social.ui.AvatarView
                android:id="@+id/projects_call_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp" />

            <ImageView
                android:id="@+id/projects_call_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/projects_social_icon_tile"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/projects_ic_megaphone"
                android:tint="@color/projects_gold_300"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/projects_call_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/figtree_semibold"
                android:textColor="@color/projects_bone_100"
                android:textSize="15sp"
                tools:text="Ayşe ekibi çağırıyor" />

            <TextView
                android:id="@+id/projects_call_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/figtree_semibold"
                android:textColor="@color/projects_gold_300"
                android:textSize="13sp"
                tools:text="Projects'te · 17 dk" />
        </LinearLayout>

        <Button
            android:id="@+id/projects_call_end"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/figtree_semibold"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:text="@string/projects_crew_call_end"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projects_call_answers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/projects_call_yes"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_crew_call_yes"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/projects_call_soon"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_crew_call_soon"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/projects_call_no"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_crew_call_no"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- FIX2: who answered opens in place, as on a plan's card. -->
    <include layout="@layout/view_projects_answers" />
</LinearLayout>
