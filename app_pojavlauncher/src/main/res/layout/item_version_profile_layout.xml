<?xml version="1.0" encoding="utf-8"?>
<!-- Projects fork (M14): a row of the profile list: the profile's icon, its name and what it plays
     ("Minecraft 26.1.2, Fabric", ProfileRows). -->
<fr.spse.extended_view.ExtendedTextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/projects_profile_item"
    android:drawablePadding="12dp"
    android:ellipsize="end"
    android:fontFamily="@font/figtree_semibold"
    android:gravity="center_vertical"
    android:maxLines="2"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:textColor="@color/projects_bone_100"
    android:textSize="15sp"
    app:drawableStartIntegerScaling="true"
    app:drawableStartSize="36dp"
    tools:drawableStart="@drawable/projects_profile_default"
    tools:ignore="RtlSymmetry"
    tools:text="Projects" />
