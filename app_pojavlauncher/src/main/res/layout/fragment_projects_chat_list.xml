<?xml version="1.0" encoding="utf-8"?>
<!-- M20: "Mesajlar": the player's crews' chats and friends' conversations, the newest first, each with
     its unread count. MOB-POLISH: the rows fade out under the header (FadingRecyclerView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:id="@+id/projects_chats_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/projects_chat_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <gg.projects.mobile.social.ui.FadingRecyclerView
            android:id="@+id/projects_chats_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/projects_chats_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="12dp"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="@string/projects_chat_empty"
            android:textColor="@color/projects_ash_400"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- TABLET-M: the conversation's place beside the list in two panes (layout-w840dp-h480dp). Here it is hidden: a
         conversation open beside the list before a rotation or a resize lands in it, then opens on its own screen. -->
    <FrameLayout
        android:id="@+id/projects_chats_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
