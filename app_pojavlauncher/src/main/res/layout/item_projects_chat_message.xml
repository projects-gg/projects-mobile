<?xml version="1.0" encoding="utf-8"?>
<!-- M20: one message. The player's own sit at the end on the dark gold, the others' at the start; in
     crew chat a group of one player's messages starts with their name and ends with their face. The
     time (and "düzenlendi", and the state of the player's own) closes the group; a message that did not
     go says so under it with "Tekrar dene".
     MOB1 (CHAT2): a reply's quote above the bubble; the bubble holds the text and a link's card; a
     sticker stands without a bubble; the reactions sit under it; "Görüldü" under the player's last
     message the friend has seen. TEAM6: the sender's crew tag before their name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_msg_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom|start"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingTop="2dp">

    <FrameLayout
        android:id="@+id/projects_msg_face_slot"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible">

        <gg.projects.mobile.social.ui.AvatarView
            android:id="@+id/projects_msg_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="18dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/projects_msg_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/projects_msg_name_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <gg.projects.mobile.social.ui.CrewTagChip
                android:id="@+id/projects_msg_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/projects_msg_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_semibold"
                android:maxLines="1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12sp"
                tools:text="Ece" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/projects_msg_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/projects_chat_quote_bg"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="@drawable/projects_chat_quote_line"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/projects_msg_quote_sticker"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/projects_msg_quote_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_semibold"
                    android:maxLines="1"
                    android:textColor="@color/projects_gold_300"
                    android:textSize="12sp"
                    tools:text="Ayşe" />

                <TextView
                    android:id="@+id/projects_msg_quote_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_regular"
                    android:maxLines="2"
                    android:textColor="@color/projects_ash_300"
                    android:textSize="13sp"
                    tools:text="Akşam Projects'e geliyor musun?" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/projects_msg_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="9dp"
            tools:background="@color/projects_chat_theirs">

            <gg.projects.mobile.social.ui.ChatBubbleText
                android:id="@+id/projects_msg_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_regular"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/projects_bone_100"
                android:textColorLink="@color/projects_bone_100"
                android:textIsSelectable="false"
                android:textSize="15sp"
                tools:text="Ekip, 21:30'da buluşuyoruz" />

            <FrameLayout
                android:id="@+id/projects_msg_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/projects_msg_sticker_box"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/projects_msg_sticker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/projects_msg_sticker_unknown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/projects_chat_quote_bg"
                android:fontFamily="@font/figtree_regular"
                android:gravity="center"
                android:text="@string/projects_stickers_unknown"
                android:textColor="@color/projects_ash_400"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/projects_msg_link_refused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/figtree_regular"
            android:text="@string/projects_links_refused"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            android:visibility="gone" />

        <gg.projects.mobile.social.ui.WrapLayout
            android:id="@+id/projects_msg_reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/projects_msg_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_400"
                android:textSize="11sp"
                tools:text="21:30 · düzenlendi" />

            <ImageView
                android:id="@+id/projects_msg_status"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:visibility="gone"
                tools:src="@drawable/projects_ic_check"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/projects_msg_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/projects_row_ripple"
            android:drawablePadding="6dp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:paddingHorizontal="6dp"
            android:textColor="@color/projects_flare_400"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Gönderilemedi · Tekrar dene"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
