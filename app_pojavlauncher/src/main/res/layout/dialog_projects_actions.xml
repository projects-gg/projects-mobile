<?xml version="1.0" encoding="utf-8"?>
<!-- M20: a sheet of actions (a message's menu, a conversation's "Diğer"): an optional quote of what it
     is about, then the action rows. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/projects_actions_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="3"
            android:textColor="@color/projects_ash_300"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Ekip, 21:30'da buluşuyoruz"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/projects_actions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
