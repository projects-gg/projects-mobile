<?xml version="1.0" encoding="utf-8"?>
<!-- M20 (TEAM4): one mark on the crew rail: the crew's mark (or "+"), its tag under it, a gold dot
     for unread chat or a call, a crossed bell while muted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="64dp"
    android:layout_height="wrap_content"
    android:background="@drawable/projects_row_ripple"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <gg.projects.mobile.social.ui.CrewMarkView
            android:id="@+id/projects_rail_mark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/projects_rail_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/projects_social_icon_tile"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/projects_ic_plus"
            android:tint="@color/projects_gold_300"
            android:visibility="gone" />

        <View
            android:id="@+id/projects_rail_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:background="@drawable/projects_news_dot"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/projects_rail_muted"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/projects_social_icon_tile"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/projects_ic_bell_slash"
            android:tint="@color/projects_ash_300"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/projects_rail_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/tektur_semibold"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textColor="@color/projects_ash_300"
        android:textSize="11sp"
        tools:text="GKR" />
</LinearLayout>
