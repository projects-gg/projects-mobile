<?xml version="1.0" encoding="utf-8"?>
<!-- M19: the main menu's "Arkadaşlar" row: who is around (faces), the most useful line (a crew call,
     an invite, friends on Projects) and "Katıl" when it is one tap away. It opens the friends screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_social_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/projects_social_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="44dp">

        <ImageView
            android:id="@+id/projects_social_row_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/projects_social_icon_tile"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/projects_ic_users"
            android:tint="@color/projects_gold_300" />

        <LinearLayout
            android:id="@+id/projects_social_row_faces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_social_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="2"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp"
            tools:text="Arkadaşlar" />

        <TextView
            android:id="@+id/projects_social_row_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="1"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="3 arkadaşın çevrimiçi" />
    </LinearLayout>

    <Button
        android:id="@+id/projects_social_row_action"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:drawableStart="@drawable/projects_join_glyph"
        android:drawablePadding="6dp"
        android:fontFamily="@font/figtree_semibold"
        android:minWidth="0dp"
        android:minHeight="44dp"
        android:text="@string/projects_social_join"
        android:textAllCaps="false"
        android:textColor="@color/projects_bone_100"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:id="@+id/projects_social_row_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/projects_news_dot"
        android:visibility="gone" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/projects_ic_caret_right"
        android:tint="@color/projects_ash_400" />
</LinearLayout>
