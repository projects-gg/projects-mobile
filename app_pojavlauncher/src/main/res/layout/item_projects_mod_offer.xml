<?xml version="1.0" encoding="utf-8"?>
<!-- The mod screen's offer to sets made before 0.1.5: "Sodium artık telefonunda da çalışıyor", with
     a gold "Aç" and a quiet "Kapalı kalsın" under the text, so the sentence keeps the full width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/projects_card_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_lightning"
            android:tint="@color/projects_gold_300" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/projects_offer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/projects_bone_100"
                android:textSize="14sp"
                tools:text="Sodium artık telefonunda da çalışıyor." />

            <TextView
                android:id="@+id/projects_offer_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_400"
                android:textSize="13sp"
                tools:text="Oyun onunla daha akıcı çalışır." />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/projects_offer_keep"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAllCaps="false"
            android:textColor="@color/projects_ash_300"
            android:textSize="13.5sp"
            tools:text="Kapalı kalsın" />

        <Button
            android:id="@+id/projects_offer_on"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/tektur_semibold"
            android:minWidth="88dp"
            android:minHeight="44dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textAllCaps="false"
            android:textColor="@color/projects_on_gold_text"
            android:textSize="14sp"
            tools:text="Aç" />
    </LinearLayout>
</LinearLayout>
