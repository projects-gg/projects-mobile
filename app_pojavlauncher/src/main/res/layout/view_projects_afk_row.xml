<?xml version="1.0" encoding="utf-8"?>
<!-- PHONE-AFK (AFK-M-UI): the main menu's "AFK hesapları" row for a player with AFK accounts on this phone, 7/24 Bulut's
     row's twin: the line that matters most (an account that stopped, how many are in the game). It opens the AFK
     screen. Without AFK accounts the menu's tools hold the entry instead; with the feature off neither shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_afk_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/projects_social_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/projects_afk_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/projects_social_icon_tile"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/projects_ic_robot"
        android:tint="@color/projects_gold_300" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_afk_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="1"
            android:text="@string/projects_afk_ui_title"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/projects_afk_row_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="1"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="2 hesap oyunda" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/projects_ic_caret_right"
        android:tint="@color/projects_ash_400" />
</LinearLayout>
