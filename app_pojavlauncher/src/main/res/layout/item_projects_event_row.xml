<?xml version="1.0" encoding="utf-8"?>
<!-- One event in "Diğer etkinlikler": title, then its time as the card says it ("2 saat 14 dakika
     kaldı", "Cumartesi 20:00'de başlıyor"; no state word, the desktop's list). Rows look alike; the ones
     that open something get a ripple and a mark (set in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_event_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="2"
            android:textColor="@color/projects_bone_100"
            android:textSize="14.5sp"
            tools:text="Yeni oyuncu haftası" />

        <TextView
            android:id="@+id/projects_event_row_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/projects_ash_300"
            android:textSize="12.5sp"
            tools:text="4 gün 12 saat kaldı" />
    </LinearLayout>

    <!-- "Hatırlat" for an upcoming event (a live one has none). -->
    <gg.projects.mobile.ui.ReminderBellView
        android:id="@+id/projects_event_row_bell"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/projects_event_row_caret"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/projects_ic_caret_right"
        android:tint="@color/projects_ash_400"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
