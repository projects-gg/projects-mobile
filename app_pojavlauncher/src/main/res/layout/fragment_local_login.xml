<?xml version="1.0" encoding="utf-8"?>
<!-- Projects fork: the offline account's name, checked as it is typed (LocalLoginFragment): label,
     field, the message (two lines kept free, so the button does not move when one appears) and the
     button. M14: a sub-screen with its header and a phone-width column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/projects_auth_local" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp">

        <TextView
            android:id="@+id/login_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:labelFor="@+id/login_edit_email"
            android:text="@string/login_online_username_hint"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@+id/login_edit_email"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/login_edit_email"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/projects_input"
            android:fontFamily="@font/figtree_regular"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/projects_bone_100"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/login_label"
            app:layout_constraintWidth_max="440dp" />

        <TextView
            android:id="@+id/login_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/figtree_regular"
            android:minLines="2"
            android:textColor="@color/projects_flare_400"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@+id/login_edit_email"
            app:layout_constraintStart_toStartOf="@+id/login_edit_email"
            app:layout_constraintTop_toBottomOf="@+id/login_edit_email" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/login_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/projects_offline_add"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/login_edit_email"
            app:layout_constraintStart_toStartOf="@+id/login_edit_email"
            app:layout_constraintTop_toBottomOf="@+id/login_message" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
