<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium"
    >

    <View
        android:id="@+id/login_menu"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_200sdp"

        android:background="@drawable/background_card"
        android:translationZ="-1dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Projects fork: the offline account's name, checked as it is typed (LocalLoginFragment):
         label, field, a message line for problems and the button, packed in the card's middle. -->
    <TextView
        android:id="@+id/login_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        android:fontFamily="@font/figtree_semibold"
        android:labelFor="@+id/login_edit_email"
        android:text="@string/login_online_username_hint"
        android:textColor="@color/projects_bone_100"
        android:textSize="@dimen/_11ssp"

        app:layout_constraintBottom_toTopOf="@+id/login_edit_email"
        app:layout_constraintStart_toStartOf="@+id/login_edit_email"
        app:layout_constraintTop_toTopOf="@+id/login_menu"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:id="@+id/login_edit_email"
        android:layout_width="0dp"
        android:layout_height="@dimen/_37sdp"
        android:layout_marginHorizontal="@dimen/_25sdp"
        android:background="@drawable/projects_input"
        android:fontFamily="@font/figtree_regular"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword|textNoSuggestions"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/projects_bone_100"
        android:textSize="@dimen/_13ssp"

        app:layout_constraintBottom_toTopOf="@+id/login_message"
        app:layout_constraintEnd_toEndOf="@+id/login_menu"
        app:layout_constraintStart_toStartOf="@+id/login_menu"
        app:layout_constraintTop_toBottomOf="@+id/login_label" />

    <TextView
        android:id="@+id/login_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="@font/figtree_regular"
        android:minLines="1"
        android:textColor="@color/projects_flare_400"
        android:textSize="@dimen/_10ssp"

        app:layout_constraintBottom_toTopOf="@+id/login_button"
        app:layout_constraintEnd_toEndOf="@+id/login_edit_email"
        app:layout_constraintStart_toStartOf="@+id/login_edit_email"
        app:layout_constraintTop_toBottomOf="@+id/login_edit_email" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/login_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:text="@string/projects_offline_add"
        android:textSize="@dimen/_12ssp"

        app:layout_constraintBottom_toBottomOf="@+id/login_menu"
        app:layout_constraintEnd_toEndOf="@+id/login_edit_email"
        app:layout_constraintStart_toStartOf="@+id/login_edit_email"
        app:layout_constraintTop_toBottomOf="@+id/login_message" />

</androidx.constraintlayout.widget.ConstraintLayout>
