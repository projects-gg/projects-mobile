<?xml version="1.0" encoding="utf-8"?>
<!-- M19: "Arkadaş ayarları": privacy, which notifications come to this phone, blocked players, and the
     account (sign out, delete my data). Rows are built in SocialSettingsFragment. MOB-POLISH: the rows
     fade out under the header (FadingScrollView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/projects_social_settings" />

    <gg.projects.mobile.social.ui.FadingScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/projects_social_settings_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp" />
    </gg.projects.mobile.social.ui.FadingScrollView>
</LinearLayout>
