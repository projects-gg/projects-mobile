<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <!-- M14: back and the title, as on every sub-screen. -->
    <gg.projects.mobile.ui.ScreenHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/projects_news_title" />

    <LinearLayout
        android:id="@+id/projects_news_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/projects_news_message_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp"
            tools:text="Henüz haber yok" />

        <TextView
            android:id="@+id/projects_news_message_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="Projects ekibinin duyuruları burada görünecek." />

        <Button
            android:id="@+id/projects_news_retry"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="44dp"
            android:text="@string/projects_retry"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/projects_news_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/projects_news_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_regular"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/projects_ash_400"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
