<?xml version="1.0" encoding="utf-8"?>
<!-- A library: installed while an enabled mod needs it, never a choice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/projects_mod_icon_frame"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/projects_icon_placeholder">

        <TextView
            android:id="@+id/projects_mod_monogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/tektur_semibold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/projects_ash_400"
            android:textSize="14sp"
            tools:text="F" />

        <ImageView
            android:id="@+id/projects_mod_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projects_mod_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="1"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp"
            tools:text="Fabric API" />

        <TextView
            android:id="@+id/projects_mod_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="1"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Sodium için"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/projects_mod_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/figtree_regular"
        android:textColor="@color/projects_ash_400"
        android:textSize="12sp"
        tools:text="Kurulu" />
</LinearLayout>
