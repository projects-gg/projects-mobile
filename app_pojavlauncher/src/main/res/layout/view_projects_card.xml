<?xml version="1.0" encoding="utf-8"?>
<!-- Projects home card: the latest story with the card's actions, then the desktop news column's
     sections (MOB-POLISH, HOME-TASTE): the pack's mods, the event, the patch notes and the community
     row, each under a hairline instead of a raised box of its own. OYNA stays the one gold thing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/projects_card_background"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_emblem" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/tektur_semibold"
            android:text="@string/projects_brand"
            android:textColor="@color/projects_bone_100"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/projects_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/figtree_regular"
            android:gravity="end"
            android:maxWidth="180dp"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Çevrim dışı. Son güncelleme: 15 Eki 14:30"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- The notice: Studio's maintenance notice, or else an active problem on the status page (from
         the Discord feed). One at a time, maintenance first; the status page opens from the whole block.
         A quiet panel: only its icon carries the colour (gold, or flare for an outage). -->
    <LinearLayout
        android:id="@+id/projects_maintenance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/projects_maintenance_background"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/projects_maintenance_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="0.5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_wrench"
            android:tint="@color/projects_gold_300" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/projects_maintenance_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:textColor="@color/projects_bone_100"
                android:textSize="14sp"
                tools:text="Bakım çalışması" />

            <TextView
                android:id="@+id/projects_maintenance_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_300"
                android:textSize="13sp"
                tools:text="Sunucular kısa bir süre bakımda olacak." />

            <TextView
                android:id="@+id/projects_maintenance_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawableEnd="@drawable/projects_ic_arrow_square_out_small"
                android:drawablePadding="4dp"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center_vertical"
                android:text="@string/projects_status_page"
                android:textColor="@color/projects_gold_300"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading: skeleton shaped like a news entry. -->
    <LinearLayout
        android:id="@+id/projects_skeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        tools:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:background="@drawable/projects_skeleton_bar" />

        <View
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/projects_skeleton_bar" />

        <View
            android:layout_width="220dp"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/projects_skeleton_bar" />
    </LinearLayout>

    <!-- The latest story: the cover, the title, what it is and when in one quiet line (no coloured
         category pill, and nothing above the title: the desktop's rows), the summary. -->
    <LinearLayout
        android:id="@+id/projects_news"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Fixed 16:9 box (capped in code): the picture fades in without moving anything. -->
        <gg.projects.mobile.ui.CoverView
            android:id="@+id/projects_news_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/projects_news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tektur_semibold"
            android:maxLines="2"
            android:textColor="@color/projects_bone_100"
            android:textSize="17sp"
            tools:text="2.3 yama notları" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_news_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12.5sp"
                tools:text="Yama notları" />

            <!-- Shown while the story is new to the player; it fades out once read and keeps its room. -->
            <View
                android:id="@+id/projects_news_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/projects_news_dot"
                android:contentDescription="@string/projects_news_new"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/projects_news_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12.5sp"
                tools:text="3 gün önce" />
        </LinearLayout>

        <TextView
            android:id="@+id/projects_news_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textColor="@color/projects_ash_300"
            android:textSize="14sp"
            tools:text="Yeni modlar ve performans iyileştirmeleri." />
    </LinearLayout>

    <!-- Empty, offline and update states. -->
    <LinearLayout
        android:id="@+id/projects_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/projects_message_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp"
            tools:text="Haberler yüklenemedi" />

        <TextView
            android:id="@+id/projects_message_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="İnternet bağlantını kontrol edip tekrar dene." />
    </LinearLayout>

    <!-- The card's two actions, quiet (OYNA below is the one gold button): the join, wide, with the
         gold play mark the event's "Katıl" has, and the news list. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/projects_join_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/projects_join_glyph"
            android:drawablePadding="8dp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/projects_join"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14.5sp" />

        <Button
            android:id="@+id/projects_secondary_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_all_news"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14.5sp" />
    </LinearLayout>

    <!-- M17: the Projects profile's options.txt still has the mods' clashing keys (saved before 0.1.6).
         One tap fixes them; shown on one home visit, gone once fixed or set aside. -->
    <LinearLayout
        android:id="@+id/projects_keyfix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/projects_notice_background"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/projects_ic_keyboard"
                android:tint="@color/projects_gold_300" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/projects_keyfix_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/projects_keyfix_title"
                    android:textColor="@color/projects_bone_100"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/projects_keyfix_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/figtree_regular"
                    android:text="@string/projects_keyfix_body"
                    android:textColor="@color/projects_ash_300"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/projects_keyfix_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/projects_icon_button_ripple"
                android:contentDescription="@string/projects_not_now"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/projects_ic_x"
                android:tint="@color/projects_ash_400" />
        </LinearLayout>

        <Button
            android:id="@+id/projects_keyfix_fix"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_keyfix_action"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- M18 (0.1.9): Android 13+ hides notifications until allowed. Asked once on the home card, the key
         fix's quiet block with a bell: "İzin ver" brings Android's own question, × sets it aside for good. -->
    <LinearLayout
        android:id="@+id/projects_notify_offer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/projects_notice_background"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/projects_ic_bell"
                android:tint="@color/projects_gold_300" />

            <TextView
                android:id="@+id/projects_notify_offer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="11dp"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/projects_notify_offer_title"
                android:textColor="@color/projects_bone_100"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/projects_notify_offer_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/projects_icon_button_ripple"
                android:contentDescription="@string/projects_not_now"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/projects_ic_x"
                android:tint="@color/projects_ash_400" />
        </LinearLayout>

        <Button
            android:id="@+id/projects_notify_offer_allow"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_notify_offer_allow"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sections, full width of the card (the hairline from edge to edge), under one another. -->

    <!-- The official pack's mods: opens the mod screen. Shown when a pack is published. -->
    <LinearLayout
        android:id="@+id/projects_mods_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-16dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_puzzle"
            android:tint="@color/projects_ash_300" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/figtree_semibold"
            android:text="@string/projects_mods"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/projects_mods_row_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/projects_badge_gold"
            android:fontFamily="@font/figtree_semibold"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/projects_mods_badge_new"
            android:textColor="@color/projects_gold_300"
            android:textSize="11.5sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/projects_mods_row_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/projects_ash_300"
            android:textSize="13sp"
            tools:text="6 mod açık" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_caret_right"
            android:tint="@color/projects_ash_400" />
    </LinearLayout>

    <!-- The event the card shows (live first, else the next one; the others behind "1 etkinlik daha"):
         its heading, its name, and its time as one sentence ("2 saat 14 dakika kaldı", the desktop's
         HOME-TASTE: no ticking digits), with the bell before it starts and "Katıl" while one on the
         server runs. -->
    <LinearLayout
        android:id="@+id/projects_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_event_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/tektur_semibold"
                android:maxLines="1"
                android:textColor="@color/projects_bone_100"
                android:textSize="15sp"
                tools:text="Süren etkinlik" />

            <!-- "1 etkinlik daha": a quiet link with the column's caret (its touch area reaches 48 dp). -->
            <TextView
                android:id="@+id/projects_event_more"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/projects_row_ripple"
                android:drawableEnd="@drawable/projects_ic_caret_right_small"
                android:drawablePadding="2dp"
                android:fontFamily="@font/figtree_semibold"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:textColor="@color/projects_ash_300"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="1 etkinlik daha"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_event_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_semibold"
                android:maxLines="2"
                android:textColor="@color/projects_bone_100"
                android:textSize="15sp"
                tools:text="Kış etkinliği finali" />

            <ImageView
                android:id="@+id/projects_event_caret"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/projects_ic_caret_right"
                android:tint="@color/projects_ash_400"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- The time as a sentence; the bell sits at its end before the event, "Katıl" while it runs. -->
        <LinearLayout
            android:id="@+id/projects_event_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_event_when"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_regular"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textColor="@color/projects_ash_300"
                android:textSize="13sp"
                tools:text="2 saat 14 dakika kaldı" />

            <gg.projects.mobile.ui.ReminderBellView
                android:id="@+id/projects_event_bell"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- M17: joins the server the Projects profile joins, like "Projects'e katıl". -->
            <Button
                android:id="@+id/projects_event_join"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:drawableStart="@drawable/projects_join_glyph"
                android:drawablePadding="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:text="@string/projects_event_join"
                android:textAllCaps="false"
                android:textColor="@color/projects_bone_100"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Newest patch notes from Studio or the Discord feed (one link to the article: "Tamamını oku"),
         else the pack's changelog with its version as the title and no link. -->
    <LinearLayout
        android:id="@+id/projects_patch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/tektur_semibold"
                android:text="@string/projects_patch_notes"
                android:textColor="@color/projects_bone_100"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/projects_patch_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableEnd="@drawable/projects_ic_caret_right_small"
                android:drawablePadding="2dp"
                android:fontFamily="@font/figtree_semibold"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:text="@string/projects_patch_read"
                android:textColor="@color/projects_ash_300"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/projects_patch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_semibold"
            android:maxLines="1"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp"
            tools:text="2.5 yama notları" />

        <LinearLayout
            android:id="@+id/projects_patch_when_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/projects_patch_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/projects_news_dot"
                android:contentDescription="@string/projects_news_new"
                android:visibility="gone" />

            <TextView
                android:id="@+id/projects_patch_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:textColor="@color/projects_ash_300"
                android:textSize="12.5sp"
                tools:text="1 saat önce" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/projects_patch_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- HOME1: the community row (wiki, Discord, forum, then the social accounts Studio publishes),
         quiet marks in the text colour, no brand colours; filled in code. -->
    <LinearLayout
        android:id="@+id/projects_links"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp" />
</LinearLayout>
