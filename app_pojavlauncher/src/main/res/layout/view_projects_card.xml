<?xml version="1.0" encoding="utf-8"?>
<!-- Projects home card: latest news from the signed content index and the join action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/projects_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_emblem" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/tektur_semibold"
            android:text="@string/projects_brand"
            android:textColor="@color/projects_bone_100"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/projects_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/figtree_regular"
            android:gravity="end"
            android:maxWidth="180dp"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Çevrim dışı. Son güncelleme: 15 Eki 14:30"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projects_maintenance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/projects_maintenance_background"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/projects_maintenance_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp"
            tools:text="Bakım çalışması" />

        <TextView
            android:id="@+id/projects_maintenance_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_bone_100"
            android:textSize="13sp"
            tools:text="Sunucular kısa bir süre bakımda olacak." />
    </LinearLayout>

    <!-- Loading: skeleton shaped like a news entry. -->
    <LinearLayout
        android:id="@+id/projects_skeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        tools:visibility="gone">

        <View
            android:layout_width="96dp"
            android:layout_height="12dp"
            android:background="@drawable/projects_skeleton_bar" />

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/projects_skeleton_bar" />

        <View
            android:layout_width="220dp"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/projects_skeleton_bar" />
    </LinearLayout>

    <!-- Latest news entry. -->
    <LinearLayout
        android:id="@+id/projects_news"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/projects_news_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:adjustViewBounds="true"
            android:maxHeight="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projects_news_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/projects_chip_background"
                android:fontFamily="@font/figtree_semibold"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/projects_gold_300"
                android:textSize="12sp"
                tools:text="Yama notları" />

            <TextView
                android:id="@+id/projects_news_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/figtree_regular"
                android:textColor="@color/projects_ash_400"
                android:textSize="12sp"
                tools:text="15 Ekim 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/projects_news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/tektur_semibold"
            android:maxLines="2"
            android:textColor="@color/projects_bone_100"
            android:textSize="17sp"
            tools:text="2.3 yama notları" />

        <TextView
            android:id="@+id/projects_news_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:textColor="@color/projects_ash_400"
            android:textSize="14sp"
            tools:text="Yeni modlar ve performans iyileştirmeleri." />
    </LinearLayout>

    <!-- Empty, offline and update states. -->
    <LinearLayout
        android:id="@+id/projects_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/projects_message_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp"
            tools:text="Haberler yüklenemedi" />

        <TextView
            android:id="@+id/projects_message_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="İnternet bağlantını kontrol edip tekrar dene." />
    </LinearLayout>

    <!-- The official pack's mods: opens the mod screen. Shown when a pack is published. -->
    <LinearLayout
        android:id="@+id/projects_mods_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/projects_row_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_puzzle"
            android:tint="@color/projects_gold_300" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/figtree_semibold"
            android:text="@string/projects_mods"
            android:textColor="@color/projects_bone_100"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/projects_mods_row_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/projects_badge_gold"
            android:fontFamily="@font/figtree_semibold"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/projects_mods_badge_new"
            android:textColor="@color/projects_gold_300"
            android:textSize="11.5sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/projects_mods_row_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/projects_ash_400"
            android:textSize="13sp"
            tools:text="6 mod açık" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_caret_right"
            android:tint="@color/projects_ash_400" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/projects_join_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/tektur_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_join"
            android:textAllCaps="false"
            android:textColor="@color/projects_on_gold_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/projects_secondary_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/figtree_semibold"
            android:minHeight="48dp"
            android:text="@string/projects_all_news"
            android:textAllCaps="false"
            android:textColor="@color/projects_bone_100"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
