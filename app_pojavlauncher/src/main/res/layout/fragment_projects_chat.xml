<?xml version="1.0" encoding="utf-8"?>
<!-- M20: a conversation (crew chat or a friend's direct messages). The header names it; a direct
     conversation has the small "Discord'dan mesajlaş" under it; the messages fill the screen, newest at
     the bottom; crew chat has quick replies above the rounded field and its round send button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:id="@+id/projects_chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp"
        android:text="@string/projects_chat_title" />

    <Button
        android:id="@+id/projects_chat_discord"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/projects_pill_background"
        android:drawablePadding="8dp"
        android:fontFamily="@font/figtree_semibold"
        android:minWidth="0dp"
        android:minHeight="36dp"
        android:paddingHorizontal="12dp"
        android:text="@string/projects_chat_discord"
        android:textAllCaps="false"
        android:textColor="@color/projects_ash_300"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/projects_chat_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/projects_social_section_background"
        android:drawablePadding="10dp"
        android:fontFamily="@font/figtree_regular"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/projects_ash_300"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Mesajlar şu an yalnız çevrimiçi olanlara gidiyor."
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projects_chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/projects_chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="12dp"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="@string/projects_chat_empty"
            android:textColor="@color/projects_ash_400"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/projects_chat_jump"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/projects_chat_jump_bg"
            android:drawablePadding="6dp"
            android:elevation="4dp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/projects_chat_jump"
            android:textColor="@color/projects_gold_300"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/projects_chat_quick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/projects_chat_quick_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/projects_chat_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_pencil"
            android:tint="@color/projects_gold_300" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/projects_chat_editing"
                android:textColor="@color/projects_gold_300"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/projects_chat_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:textColor="@color/projects_ash_400"
                android:textSize="13sp"
                tools:text="Geliyrum" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/projects_chat_edit_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/projects_icon_button_ripple"
            android:contentDescription="@string/projects_social_cancel"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/projects_ic_x"
            android:tint="@color/projects_ash_300" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projects_chat_problem_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/projects_chat_problem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/figtree_regular"
            android:textColor="@color/projects_flare_400"
            android:textSize="12sp"
            tools:text="Bağlantı gönderilemez." />

        <TextView
            android:id="@+id/projects_chat_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/projects_ash_400"
            android:textSize="12sp"
            tools:text="281/300" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projects_chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/projects_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/projects_chat_input"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center_vertical|start"
            android:hint="@string/projects_chat_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1200"
            android:maxLines="5"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/projects_bone_100"
            android:textColorHint="@color/projects_ash_400"
            android:textCursorDrawable="@null"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/projects_chat_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/projects_chat_send_bg"
            android:contentDescription="@string/projects_chat_send"
            android:enabled="false"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/projects_ic_send" />
    </LinearLayout>

    <TextView
        android:id="@+id/projects_chat_closed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/projects_social_row_background"
        android:fontFamily="@font/figtree_regular"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/projects_ash_300"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="22 Ekim 21:30 tarihine kadar mesaj gönderemezsin." />
</LinearLayout>
