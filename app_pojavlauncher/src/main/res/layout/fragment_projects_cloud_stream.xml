<?xml version="1.0" encoding="utf-8"?>
<!-- AFKPLUS-M: a stream of lines with a composer: a cloud account's console and an AFK+ conversation. The top
     strip holds the state line, the console's filter row (FEAT-M) and notices; the list scrolls; the composer
     sits at the bottom with the line under it (encrypted, why it can't be written). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical">

    <gg.projects.mobile.ui.ScreenHeader
        android:id="@+id/projects_cloud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:id="@+id/projects_cloud_stream_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projects_cloud_stream_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/projects_cloud_stream_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/projects_cloud_stream_jump"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/projects_chat_jump_bg"
            android:elevation="4dp"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:textColor="@color/projects_gold_300"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/projects_cloud_stream_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/projects_cloud_stream_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/projects_chat_input"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center_vertical|start"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:maxLines="3"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/projects_bone_100"
            android:textColorHint="@color/projects_ash_400"
            android:textCursorDrawable="@null"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/projects_cloud_stream_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/projects_chat_send_bg"
            android:enabled="false"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/projects_ic_send" />
    </LinearLayout>

    <TextView
        android:id="@+id/projects_cloud_stream_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:drawablePadding="6dp"
        android:fontFamily="@font/figtree_regular"
        android:gravity="center_vertical"
        android:minHeight="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/projects_ash_400"
        android:textSize="12.5sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
