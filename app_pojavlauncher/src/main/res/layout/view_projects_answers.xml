<?xml version="1.0" encoding="utf-8"?>
<!-- FIX2: who answered a plan or a call. Folded: the short tally ("Geliyor: Ece, Kaan" then "Belki: Deniz", apart by a gap)
     with a chevron; open: "Kimler geliyor" over the people grouped by answer, each group with its count,
     its first four and "N kişi daha". A tap anywhere on the line opens or folds it in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projects_answers"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/projects_answers_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/projects_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/projects_answers_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_regular"
            android:maxLines="2"
            android:textColor="@color/projects_ash_300"
            android:textSize="13sp"
            tools:text="Geliyor: Ece, Kaan  Belki: Deniz" />

        <ImageView
            android:id="@+id/projects_answers_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/projects_ic_caret_down_bold"
            android:tint="@color/projects_ash_300" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projects_answers_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
