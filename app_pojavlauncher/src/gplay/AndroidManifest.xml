<?xml version="1.0" encoding="utf-8"?>
<!-- APK-UPD: the Play build has no updater of its own (Play forbids an app updating itself another way and
     allows REQUEST_INSTALL_PACKAGES only to apps whose job is installing): the permissions and the receiver go.
     PHONE-AFK: no phone AFK on Play (its wake lock and battery policy; docs/tasks/phone-afk.md §4): the service, its
     watchdog and the battery question go too (BuildConfig.PROJECTS_PHONE_AFK is false there). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <application>
        <receiver
            android:name="gg.projects.mobile.update.UpdateReceiver"
            tools:node="remove" />
        <service
            android:name="gg.projects.mobile.afk.service.AfkService"
            tools:node="remove" />
        <activity
            android:name="gg.projects.mobile.afk.service.AfkOpenActivity"
            tools:node="remove" />
    </application>
</manifest>
